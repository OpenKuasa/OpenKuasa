# OpenKuasa OS — environment template.
# Copy to .env.local and fill in. .env.local is gitignored; never commit real secrets.
#
# Two consumers:
#   - The Next.js app auto-loads .env.local at dev/build (NEXT_PUBLIC_*, keys, model vars).
#   - The openkuasa-supabase MCP reads OPENKUASA_SUPABASE_TOKEN from your shell at launch:
#       set -a; source .env.local; set +a; claude
#     (or: npx dotenv-cli -e .env.local -- claude)
#
# Keep lines as clean KEY=value with no inline comments, so `source` works.

# --- Tooling / MCP (loaded into the shell at launch) -------------------------
# Supabase personal access token (Account -> Access Tokens). Used by the openkuasa-supabase MCP.
OPENKUASA_SUPABASE_TOKEN=
# GitHub token for the OpenKuasa identity. Uncomment to launch with GitHub in the same session.
# GH_TOKEN=

# --- Supabase (app runtime) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed/admin scripts, never in the request path.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider -------------------------------------------------------------
# Default provider: OpenRouter (one key, any model).
OPENROUTER_API_KEY=
# Per-layer model slugs from OpenRouter (see https://openrouter.ai/models for exact ids).
# Orchestrator = a strong model; worker = a cheaper/faster one.
OPENKUASA_MODEL_ORCHESTRATOR=
OPENKUASA_MODEL_WORKER=
# Optional: the model that reads uploaded receipts (Bendahara, Receipts Inbox). It must take images and PDFs.
# Unset, receipts are read by OPENKUASA_MODEL_WORKER; with neither set, reading receipts is switched off.
# OPENKUASA_MODEL_RECEIPTS=
# Optional: set to use direct Anthropic instead of OpenRouter.
# ANTHROPIC_API_KEY=
# Optional: Cloudflare AI Gateway base URL (opt-in; adds a second intermediary on the data path).
# AI_GATEWAY_BASE_URL=

# --- Features ----------------------------------------------------------------
# '1' shows the "Explore the demo" button (per-visitor anonymous sign-in).
NEXT_PUBLIC_DEMO_ENABLED=1
