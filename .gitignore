# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/evals/reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json

# local MCP server config (personal tooling, not shipped)
.mcp.json

# superpowers SDD workspace + local MCP scratch (not shipped)
.superpowers/
.playwright-mcp/

# planning notes stay local (not shipped)
docs/superpowers/
