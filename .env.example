# OpenKuasa OS — environment template. Never commit real secrets.
#
# Two ways to run OpenKuasa, two sections below:
#
#   Docker (local)       cp .env.example .env && docker compose up -d
#                        Nothing is required: a blank copy works. Every value
#                        marked "generated on first run if blank" is created once
#                        by the `init` container and kept in a Docker volume;
#                        a value you type here always wins. Optional keys only
#                        switch extra features on.
#
#   Hosted Supabase /    Copy to .env.local and fill in the second section.
#   pnpm dev             .env.local is gitignored.
#
# The Docker .env holds no Supabase URL or keys (generated ones live in a Docker
# volume), so `pnpm dev` still uses .env.local, or sample data without it.
#
# Keep lines as clean KEY=value with no inline comments, so `source` works.
# Each name appears once in this file (a second, blank copy would override yours).

# =============================================================================
# Docker (local)
# =============================================================================

# --- Generated on first run if blank -----------------------------------------
# Database password. If you set your own, use letters and digits only (it is
# placed inside connection URLs).
POSTGRES_PASSWORD=
# Supabase JWT secret, and the two API keys signed with it. Set your own
# JWT_SECRET and the keys are signed again to match it.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# The app's own secrets.
AUTH_COOKIE_SECRET=
AI_KEYS_ENCRYPTION_SECRET=
RATE_LIMIT_PEPPER=
# Scheduler (cron) credential, 32+ random characters: openssl rand -hex 32
# (used by the hosted setup below too).
CRON_SECRET=

# --- Optional (also used by the hosted setup below) --------------------------
# AI provider. Default: OpenRouter (one key, any model). Without a key, the AI
# chat asks each workspace for its own key.
OPENROUTER_API_KEY=
# Per-layer model slugs from OpenRouter (see https://openrouter.ai/models for exact ids).
# Orchestrator = a strong model; worker = a cheaper/faster one.
OPENKUASA_MODEL_ORCHESTRATOR=
OPENKUASA_MODEL_WORKER=
# Optional: the model that reads uploaded receipts (Bendahara, Receipts Inbox). It must take images and PDFs.
# Unset, receipts are read by OPENKUASA_MODEL_WORKER; with neither set, reading receipts is switched off.
# OPENKUASA_MODEL_RECEIPTS=
# Optional: set to use direct Anthropic instead of OpenRouter.
# ANTHROPIC_API_KEY=
# Optional: Cloudflare AI Gateway base URL (opt-in; adds a second intermediary on the data path).
# AI_GATEWAY_BASE_URL=
# Optional: image tag of the app to run (default latest).
# OPENKUASA_IMAGE_TAG=

# =============================================================================
# Hosted Supabase / pnpm dev
# =============================================================================
# Two consumers:
#   - The Next.js app auto-loads .env.local at dev/build (NEXT_PUBLIC_*, keys, model vars).
#   - The openkuasa-supabase MCP reads OPENKUASA_SUPABASE_TOKEN from your shell at launch:
#       set -a; source .env.local; set +a; claude
#     (or: npx dotenv-cli -e .env.local -- claude)
# The AI provider settings and CRON_SECRET above apply here too.

# --- Tooling / MCP (loaded into the shell at launch) -------------------------
# Supabase personal access token (Account -> Access Tokens). Used by the openkuasa-supabase MCP.
OPENKUASA_SUPABASE_TOKEN=
# GitHub token for the OpenKuasa identity. Uncomment to launch with GitHub in the same session.
# GH_TOKEN=

# --- Supabase (app runtime) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed/admin scripts, never in the request path.
SUPABASE_SERVICE_ROLE_KEY=

# --- Features ----------------------------------------------------------------
# '1' shows the "Explore the demo" button (per-visitor anonymous sign-in).
# (The Docker setup turns the demo on by itself.)
NEXT_PUBLIC_DEMO_ENABLED=1

# Transition only: also accept the old service-role key from the scheduler. Set to false once it sends CRON_SECRET.
CRON_ALLOW_LEGACY_KEY=true
# 'true' turns on "Sign in with OpenKuasa" for MCP apps (needs the Supabase OAuth server on). Empty = API keys only.
MCP_SIGN_IN_ENABLED=
